<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.9">
  <model name="orda_car">
    <self_collide>false</self_collide>
    <link name="chassis">
      <pose>0 0 0.20 0 0 0</pose>
      <inertial>
        <mass>2</mass>
        <inertia>
          <ixx>0.025</ixx>
          <iyy>0.075</iyy>
          <izz>0.085</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="body_collision">
        <geometry>
          <box>
            <size>.65 .30 .16</size>
          </box>
        </geometry>
      </collision>
      <visual name="body">
        <geometry>
          <box>
            <size>.65 .30 .16</size>
          </box>
        </geometry>
        <material>
          <ambient>0.05 0.35 0.85 1</ambient>
          <diffuse>0.05 0.35 0.85 1</diffuse>
        </material>
      </visual>
      <visual name="hood">
        <pose>.20 0 .085 0 0 0</pose>
        <geometry>
          <box>
            <size>.18 .28 .015</size>
          </box>
        </geometry>
        <material>
          <ambient>0.9 0.9 0.94 1</ambient>
          <diffuse>0.9 0.9 0.94 1</diffuse>
        </material>
      </visual>
      <sensor name="high_camera" type="camera">
        <pose>.34 0 0.22 0 0.27 0</pose>
        <topic>/camera/high/image_raw</topic>
        <gz_frame_id>camera_high_optical</gz_frame_id>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <camera>
          <camera_info_topic>/camera/high/camera_info</camera_info_topic>
          <optical_frame_id>camera_high_optical</optical_frame_id>
          <horizontal_fov>1.2</horizontal_fov>
          <image>
            <width>320</width>
            <height>240</height>
            <format>R8G8B8</format>
            <anti_aliasing>1</anti_aliasing>
          </image>
          <clip>
            <near>.03</near>
            <far>25</far>
          </clip>
        </camera>
      </sensor>
      <visual name="high_camera_housing">
        <pose>.30 0 0.22 0 0.27 0</pose>
        <geometry>
          <box>
            <size>.05 .08 .04</size>
          </box>
        </geometry>
        <material>
          <ambient>0.08 0.08 0.1 1</ambient>
          <diffuse>0.08 0.08 0.1 1</diffuse>
        </material>
      </visual>
      <sensor name="low_camera" type="camera">
        <pose>.34 0 -0.02 0 0.12 0</pose>
        <topic>/camera/low/image_raw</topic>
        <gz_frame_id>camera_low_optical</gz_frame_id>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <camera>
          <camera_info_topic>/camera/low/camera_info</camera_info_topic>
          <optical_frame_id>camera_low_optical</optical_frame_id>
          <horizontal_fov>1.2</horizontal_fov>
          <image>
            <width>320</width>
            <height>240</height>
            <format>R8G8B8</format>
            <anti_aliasing>1</anti_aliasing>
          </image>
          <clip>
            <near>.03</near>
            <far>25</far>
          </clip>
        </camera>
      </sensor>
      <visual name="low_camera_housing">
        <pose>.30 0 -0.02 0 0.12 0</pose>
        <geometry>
          <box>
            <size>.05 .08 .04</size>
          </box>
        </geometry>
        <material>
          <ambient>0.08 0.08 0.1 1</ambient>
          <diffuse>0.08 0.08 0.1 1</diffuse>
        </material>
      </visual>
      <sensor name="lidar" type="gpu_lidar">
        <pose>0 0 .30 0 0 0</pose>
        <topic>/scan</topic>
        <gz_frame_id>laser</gz_frame_id>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <lidar>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.141592653589793</min_angle>
              <max_angle>3.12413936106985</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>.15</min>
            <max>12</max>
            <resolution>.01</resolution>
          </range>
        </lidar>
      </sensor>
      <visual name="lidar_housing">
        <pose>0 0 .27 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>.05</radius>
            <length>.04</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.12 0.12 0.14 1</ambient>
          <diffuse>0.12 0.12 0.14 1</diffuse>
        </material>
      </visual>
    </link>
    <link name="rear_left_wheel">
      <pose>-0.24 0.2 .10 0 0 0</pose>
      <inertial>
        <mass>0.15</mass>
        <inertia>
          <ixx>0.00045</ixx>
          <iyy>0.00075</iyy>
