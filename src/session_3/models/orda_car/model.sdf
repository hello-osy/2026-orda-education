    <plugin filename="gz-sim-ackermann-steering-system" name="gz::sim::systems::AckermannSteering">
      <left_joint>rear_left_axle</left_joint>
      <left_steering_joint>front_left_steering</left_steering_joint>
      <right_joint>rear_right_axle</right_joint>
      <right_steering_joint>front_right_steering</right_steering_joint>
      <wheel_base>0.48</wheel_base>
      <wheel_separation>0.4</wheel_separation>
      <kingpin_width>0.36</kingpin_width>
      <wheel_radius>0.1</wheel_radius>
      <steering_limit>0.6154797086703871</steering_limit>
      <steer_p_gain>8</steer_p_gain>
